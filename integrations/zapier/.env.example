# Local end-to-end check (npm run e2e:local). Never put a real key here.
# The keys below are the fixed local test keys that `pnpm zapier:seed-local`
# (scripts/seed-zapier-local.ts) inserts into a local database. They do not
# work anywhere else.
LOBBYSTACK_BASE_URL=http://localhost:3000
LOBBYSTACK_API_KEY=lsk_2a91e0c7_zapierLocalDevOnlyKeyNotForProd1
# Optional: a seeded key with only knowledge:write, to check that it connects.
LOBBYSTACK_NARROW_API_KEY=lsk_2a91e0c8_zapierLocalNarrowKeyKnowledgeOn1
# Set to 1, with DATABASE_URL and ENCRYPTION_KEY for the same local stack, to
# also run each trigger's perform on deliveries signed by the server's code.
ZAPIER_E2E_EVENTS_FROM_DB=0
