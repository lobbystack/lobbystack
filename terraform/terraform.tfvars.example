# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored, because it holds the OpenAI project id.

location = "polandcentral"

# Your SSH public key, and the addresses that may reach SSH. Leave the list empty to open no SSH.
ssh_public_key    = "ssh-ed25519 AAAA... you@example.com"
ssh_allowed_cidrs = ["203.0.113.7/32"]

# The same project id as OPENAI_PROJECT_ID on the worker.
openai_project_id = "proj_replace_me"

# The carrier's SIP server addresses. Ask Zadarma for them, or read the address a refused call's log line names.
# Empty leaves the server closed to every carrier.
carrier_ips = []

# An optional name for the public address: <label>.<region>.cloudapp.azure.com. It must be unique in the region.
# dns_label = "lobbystack-sip-yourname"
