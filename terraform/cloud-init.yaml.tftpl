#cloud-config
# Installs Docker, writes the SIP server's files from docker/asterisk, and starts it. Runs once, on the VM's first boot.
package_update: true
packages:
  - docker.io
  - docker-compose-v2
write_files:
%{ for path, content in files ~}
  - path: /opt/lobbystack-sip/${path}
    encoding: b64
    permissions: "${path == "entrypoint.sh" ? "0755" : "0644"}"
    content: ${content}
%{ endfor ~}
  - path: /opt/lobbystack-sip/asterisk.env
    permissions: "0600"
    content: |
      OPENAI_PROJECT_ID=${openai_project_id}
      CARRIER_IPS=${carrier_ips}
      PUBLIC_IP=${public_ip}
      DEFAULT_COUNTRY_CODE=${default_country_code}
      CALLER_HEADER=${caller_header}
      SIP_UDP_PORT=5060
      RTP_START=${rtp_start}
      RTP_END=${rtp_end}
runcmd:
  - systemctl enable --now docker
  - cd /opt/lobbystack-sip && docker compose up -d --build
