{
  "name": "lobbystack",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@polar-sh/sdk": "^0.47.0",
    "ai": "^7.0.107",
    "firecrawl": "^4.20.1",
    "jimp": "^1.6.1",
    "luxon": "^3.7.2",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pureimage": "^0.4.20",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "twilio": "^5.12.2",
    "zod": "^3.24.2"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:admin": "pnpm --filter @lobbystack/admin dev",
    "dev:worker": "pnpm --filter @lobbystack/worker dev",
    "docs:dev": "pnpm --filter @lobbystack/docs dev",
    "docs:dev:no-open": "pnpm --filter @lobbystack/docs dev:no-open",
    "docs:validate": "pnpm --filter @lobbystack/docs validate",
    "docs:broken-links": "pnpm --filter @lobbystack/docs broken-links",
    "dev:landing": "pnpm --filter @lobbystack/landing dev",
    "landing:build": "pnpm --filter @lobbystack/landing build",
    "landing:preview": "pnpm --filter @lobbystack/landing preview",
    "landing:typecheck": "pnpm --filter @lobbystack/landing typecheck",
    "dev:voice": "pnpm --filter @lobbystack/voice-gateway dev",
    "dev:onboarding:website": "tsx --tsconfig scripts/tsconfig.json scripts/prepare-onboarding-website.ts",
    "prospect-demo": "tsx --tsconfig scripts/tsconfig.json scripts/prospect-demo.ts",
    "widget:embed:build": "pnpm --filter @lobbystack/embed build && node scripts/copy-widget-embed.mjs",
    "prospect-demo:create": "tsx --tsconfig scripts/tsconfig.json scripts/prospect-demo.ts create",
    "prospect-demo:status": "tsx --tsconfig scripts/tsconfig.json scripts/prospect-demo.ts status",
    "prospect-demo:set-prompts": "tsx --tsconfig scripts/tsconfig.json scripts/prospect-demo.ts set-prompts",
    "prospect-demo:publish": "tsx --tsconfig scripts/tsconfig.json scripts/prospect-demo.ts publish",
    "prospect-demo:revoke": "tsx --tsconfig scripts/tsconfig.json scripts/prospect-demo.ts revoke",
    "build": "pnpm -r build && pnpm admin:prerender-check && node scripts/copy-widget-embed.mjs",
    "admin:prerender-check": "tsx --tsconfig scripts/tsconfig.json scripts/verify-admin-prerender.ts",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "vitest run --passWithNoTests --config scripts/vitest.config.ts",
    "test:build-config": "node --test .github/build/*.test.mjs",
    "e2e:local": "bash scripts/e2e-local.sh",
    "test:reliability": "node -e \"if (!process.env.LOBBYSTACK_RELIABILITY_TEST_DATABASE_URL) throw new Error('Set LOBBYSTACK_RELIABILITY_TEST_DATABASE_URL to a dedicated local test database')\" && pnpm --filter @lobbystack/domain exec vitest run src/server/reliability.integration.test.ts",
    "release:check": "tsx --tsconfig scripts/tsconfig.json scripts/release-readiness.ts",
    "migration:preflight": "tsx --tsconfig scripts/tsconfig.json scripts/production-migration-preflight.ts",
    "migration:plan-check": "tsx --tsconfig tsconfig.base.json scripts/migration/snapshot-plan-check.ts",
    "migration:rehearse": "tsx --tsconfig tsconfig.base.json scripts/migration/rehearsal-import.ts",
    "migration:rebuild-snapshots": "tsx --tsconfig tsconfig.base.json scripts/migration/rebuild-snapshots.ts",
    "migration:rebuild-derived": "tsx --tsconfig tsconfig.base.json scripts/migration/rebuild-derived.ts",
    "migration:reconcile": "tsx --tsconfig tsconfig.base.json scripts/migration/target-reconciliation.ts",
    "migration:production-import": "tsx --tsconfig tsconfig.base.json scripts/migration/production-import.ts",
    "migration:production-objects": "tsx --tsconfig tsconfig.base.json scripts/migration/production-objects.ts",
    "migration:legacy-freeze": "tsx --tsconfig tsconfig.base.json scripts/migration/legacy-freeze.ts",
    "migration:provision-target": "tsx --tsconfig tsconfig.base.json scripts/migration/provision-target.ts",
    "release:seed-e2e": "tsx --tsconfig scripts/tsconfig.json scripts/seed-release-e2e.ts",
    "db:generate": "pnpm --filter @lobbystack/db db:generate",
    "db:migrate": "pnpm --filter @lobbystack/db db:migrate",
    "env:generate": "node scripts/generate-env.mjs",
    "db:check": "pnpm --filter @lobbystack/db db:check",
    "db:seed": "pnpm --filter @lobbystack/db db:seed",
    "db:reset:test": "pnpm --filter @lobbystack/db db:reset:test",
    "db:verify-rls": "pnpm --filter @lobbystack/db db:verify-rls",
    "replacement:smoke": "tsx --tsconfig scripts/tsconfig.json scripts/replacement-smoke.ts",
    "smoke:production": "tsx --tsconfig scripts/tsconfig.json scripts/production-smoke.ts",
    "replacement:internal": "tsx --tsconfig scripts/tsconfig.json scripts/replacement-internal-check.ts",
    "replacement:realtime": "tsx --tsconfig tsconfig.base.json scripts/replacement-realtime-check.ts",
    "replacement:call-detail": "tsx --tsconfig tsconfig.base.json scripts/replacement-call-detail-check.ts",
    "replacement:roles": "tsx --tsconfig tsconfig.base.json scripts/replacement-role-authorization-check.ts",
    "replacement:locale": "tsx --tsconfig scripts/tsconfig.json scripts/admin-locale-check.ts",
    "replacement:storage": "tsx --tsconfig tsconfig.base.json scripts/replacement-storage-check.ts",
    "replacement:webhooks": "tsx --tsconfig tsconfig.base.json scripts/replacement-webhook-check.ts",
    "replacement:telemetry": "tsx --tsconfig tsconfig.base.json scripts/replacement-telemetry-check.ts",
    "telemetry:coverage": "tsx --tsconfig tsconfig.base.json scripts/telemetry-registry-coverage.ts",
    "replacement:privacy": "tsx --tsconfig tsconfig.base.json scripts/replacement-privacy-check.ts",
    "replacement:web-voice-policy": "tsx --tsconfig tsconfig.base.json scripts/replacement-web-voice-policy-check.ts",
    "replacement:demo": "tsx --tsconfig tsconfig.base.json scripts/replacement-demo-check.ts",
    "replacement:notifications": "tsx --tsconfig tsconfig.base.json scripts/replacement-notifications-check.ts",
    "replacement:billing": "tsx --tsconfig tsconfig.base.json scripts/replacement-billing-check.ts",
    "replacement:phone-onboarding": "tsx --tsconfig tsconfig.base.json scripts/replacement-phone-onboarding-check.ts",
    "replacement:backup": "bash scripts/replacement-backup.sh",
    "replacement:restore": "bash scripts/replacement-restore.sh",
    "replacement:restore-drill": "bash scripts/replacement-restore-drill.sh",
    "replacement:inventory": "tsx --tsconfig scripts/tsconfig.json scripts/parity-inventory.ts",
    "replacement:parity": "tsx --tsconfig scripts/tsconfig.json scripts/replacement-parity-check.ts",
    "replacement:admin-ui-parity": "tsx --tsconfig scripts/tsconfig.json scripts/admin-ui-parity-check.ts",
    "replacement:visual-coverage": "node scripts/admin-ui-visual-coverage.mjs",
    "replacement:import": "tsx --tsconfig tsconfig.base.json scripts/replacement-import.ts",
    "convex:dev:migrate": "tsx --tsconfig tsconfig.base.json scripts/migrate-convex-dev.ts",
    "replacement:import-check": "tsx --tsconfig tsconfig.base.json scripts/replacement-import-check.ts",
    "replacement:reconciliation": "tsx --tsconfig tsconfig.base.json scripts/replacement-reconciliation.ts",
    "replacement:drift": "tsx --tsconfig scripts/tsconfig.json scripts/check-drift.ts",
    "replacement:security": "tsx --tsconfig tsconfig.base.json scripts/replacement-security-check.ts",
    "replacement:recovery": "tsx --tsconfig tsconfig.base.json scripts/replacement-recovery-check.ts",
    "replacement:auth": "tsx --tsconfig tsconfig.base.json scripts/replacement-auth-check.ts",
    "replacement:email-send": "tsx --tsconfig tsconfig.base.json scripts/replacement-email-send-check.ts",
    "replacement:sms-consent": "tsx --tsconfig tsconfig.base.json scripts/replacement-sms-consent-check.ts",
    "replacement:feedback": "tsx --tsconfig tsconfig.base.json scripts/replacement-feedback-check.ts",
    "replacement:appointment-audits": "tsx --tsconfig tsconfig.base.json scripts/replacement-appointment-audit-check.ts",
    "replacement:unit-economics": "tsx --tsconfig tsconfig.base.json scripts/replacement-unit-economics-check.ts",
    "performance:http": "tsx --tsconfig tsconfig.base.json scripts/performance/run.ts",
    "performance:browser": "tsx --tsconfig tsconfig.base.json scripts/performance/browser.ts",
    "performance:analytics": "tsx --tsconfig tsconfig.base.json scripts/performance/analytics.ts",
    "performance:soak": "tsx --tsconfig tsconfig.base.json scripts/performance/soak-certification.ts",
    "operations:alert-smoke": "tsx --tsconfig tsconfig.base.json scripts/operations/alert-firing-smoke.ts",
    "replacement:performance": "tsx --tsconfig tsconfig.base.json scripts/replacement-performance-check.ts",
    "replacement:analytics-usage": "tsx --tsconfig scripts/tsconfig.json scripts/replacement-analytics-usage-check.ts",
    "replacement:follow-up": "tsx --tsconfig scripts/tsconfig.json scripts/replacement-follow-up-check.ts",
    "replacement:knowledge-lifecycle": "tsx --tsconfig scripts/tsconfig.json scripts/replacement-knowledge-lifecycle-check.ts",
    "replacement:appointment-policy": "tsx --tsconfig scripts/tsconfig.json scripts/replacement-appointment-policy-check.ts",
    "replacement:onboarding": "tsx --tsconfig scripts/tsconfig.json scripts/replacement-onboarding-check.ts",
    "replacement:catalog": "tsx --tsconfig scripts/tsconfig.json scripts/replacement-catalog-check.ts",
    "replacement:calendar": "tsx --tsconfig scripts/tsconfig.json scripts/replacement-calendar-check.ts",
    "replacement:contacts": "tsx --tsconfig scripts/tsconfig.json scripts/replacement-contact-pagination-check.ts"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.2",
    "drizzle-orm": "^0.45.2",
    "lucia": "^3.2.2",
    "next-devtools-mcp": "0.4.0",
    "playwright": "^1.58.2",
    "railway": "3.11.0",
    "standardwebhooks": "^1.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
