FROM node:22-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /app

RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @lobbystack/worker... build
RUN pnpm deploy --filter @lobbystack/worker --prod --legacy /prod/worker
RUN pnpm deploy --filter @lobbystack/db --prod --legacy /prod/db

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY --from=build /prod/worker/ ./
COPY --from=build /prod/db/ ./db

USER node
EXPOSE 3002
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=12 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3002)+'/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node_modules/.bin/tsx", "dist/apps/worker/src/index.js"]
