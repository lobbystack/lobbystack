# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@10.30.3 --activate
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY .github/build/prepare-image-workspace.mjs .github/build/prepare-image-workspace.mjs
RUN node .github/build/prepare-image-workspace.mjs --lockfile-only
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store pnpm fetch --frozen-lockfile --store-dir=/pnpm/store
COPY . .
RUN node .github/build/prepare-image-workspace.mjs
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store pnpm install --offline --frozen-lockfile --store-dir=/pnpm/store
RUN pnpm --filter @lobbystack/db... build
RUN for package in contracts db telemetry; do \
      if [ -d "packages/$package/dist/$package/src" ]; then \
        cp -R "packages/$package/dist/$package/src/." "packages/$package/dist/"; \
      fi; \
    done
# Mintlify's front-matter patch is absent from the production dependency graph.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store pnpm --config.allowUnusedPatches=true --store-dir=/pnpm/store deploy --filter @lobbystack/db --prod --legacy /prod/migrator
RUN find /prod/migrator -type f -name '*.map' -delete

FROM node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS runtime

ARG SERVICE_VERSION=development
ENV NODE_ENV=production
ENV SERVICE_VERSION=$SERVICE_VERSION
LABEL org.opencontainers.image.revision=$SERVICE_VERSION
WORKDIR /app

RUN groupadd --system --gid 1001 lobbystack && \
    useradd --system --uid 1001 --gid lobbystack lobbystack && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY --from=build --chown=lobbystack:lobbystack /prod/migrator/ ./

USER lobbystack
CMD ["node_modules/.bin/tsx", "dist/cli.js", "migrate"]
