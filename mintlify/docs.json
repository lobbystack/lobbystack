          {
            "group": "Manage",
            "pages": [
              "dashboard/analytics",
              "integrations/overview",
              "integrations/google-calendar",
              "integrations/sms",
              "integrations/webhooks",
              {
                "group": "Settings",
                "pages": [
                  "settings/overview",
                  "settings/account",
                  "settings/team",
                  "settings/notifications",
                  "settings/phone-number",
                  "settings/widget"
                ]
              },
              {
                "group": "Billing",
                "pages": [
                  "billing/plans",
                  "billing/usage",
                  "billing/affiliate-program"
                ]
              }
            ]
          },
          {
            "group": "API",
            "pages": [
              "api/overview",
              "api/authentication",
              "api/requests",
              "api/webhooks"
            ]
          },
          {
            "group": "AI assistants",
            "pages": [
              "ai/mcp",
              "ai/connect-claude",
              "ai/connect-chatgpt",
              "ai/connect-other-clients",
              "ai/lobbystack-skill"
            ]
          },
          {
            "group": "API reference",
            "openapi": "api-reference/openapi.json"
