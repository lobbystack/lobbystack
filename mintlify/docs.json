{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "LobbyStack",
  "description": "Help Center and developer documentation for LobbyStack.",
  "colors": {
    "primary": "#0B0B0D",
    "light": "#FFFFFF",
    "dark": "#0B0B0D"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Geist"
  },
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Lobbystack.com",
        "href": "https://lobbystack.com"
      },
      {
        "label": "",
        "icon": "github",
        "href": "https://github.com/lobbystack/lobbystack"
      },
      {
        "label": "Log in",
        "href": "https://app.lobbystack.com/login"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Try for free",
      "name": "Try for free",
      "href": "https://app.lobbystack.com/signup"
    }
  },
  "redirects": [
    {
      "source": "/agent/ai-settings",
      "destination": "/agent/ai-settings/overview"
    },
    {
      "source": "/agent/ai-settings/",
      "destination": "/agent/ai-settings/overview"
    },
    {
      "source": "/fr/agent/ai-settings",
      "destination": "/fr/agent/ai-settings/overview"
    },
    {
      "source": "/fr/agent/ai-settings/",
      "destination": "/fr/agent/ai-settings/overview"
    },
    {
      "source": "/es/agent/ai-settings",
      "destination": "/es/agent/ai-settings/overview"
    },
    {
      "source": "/es/agent/ai-settings/",
      "destination": "/es/agent/ai-settings/overview"
    }
  ],
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "getting-started/account-setup",
              "getting-started/claim-your-number"
            ]
          },
          {
            "group": "General",
            "pages": [
              "dashboard/home",
              "dashboard/calls",
              "dashboard/messages",
              "dashboard/contacts",
              "dashboard/appointments"
            ]
          },
          {
            "group": "Agent",
            "pages": [
              "agent/overview",
              {
                "group": "AI settings",
