{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@lobbystack/agent-core": ["./packages/agent-core/src"],
      "@lobbystack/agent-core/*": ["./packages/agent-core/src/*"],
      "@lobbystack/contracts": ["./packages/contracts/src"],
      "@lobbystack/db": ["./packages/db/src"],
      "@lobbystack/domain": ["./packages/domain/src"],
      "@lobbystack/jobs": ["./packages/jobs/src"],
      "@lobbystack/providers": ["./packages/providers/src"],
      "@lobbystack/providers/*": ["./packages/providers/src/*"],
      "@lobbystack/shared": ["./packages/shared/src"],
      "@lobbystack/telemetry": ["./packages/telemetry/src"],
      "@lobbystack/telemetry/*": ["./packages/telemetry/src/*"]
    }
  }
}
