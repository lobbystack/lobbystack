POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_PORT=15433
REDIS_PORT=16380
LOBBYSTACK_APP_PASSWORD=replace-with-app-password
LOBBYSTACK_AUTH_PASSWORD=replace-with-auth-password
LOBBYSTACK_WORKER_PASSWORD=replace-with-worker-password
LOBBYSTACK_DISPATCHER_PASSWORD=replace-with-dispatcher-password
LOBBYSTACK_MIGRATOR_PASSWORD=replace-with-migrator-password
LOBBYSTACK_READONLY_PASSWORD=replace-with-readonly-password
# Superuser URL; the migrator bootstraps roles with it and runtimes derive role URLs from its host.
DATABASE_URL=postgres://postgres:replace-with-a-long-local-password@127.0.0.1:15433/lobbystack
REDIS_URL=redis://127.0.0.1:16380
# Services build each role's connection string from DATABASE_URL and the role password above.
# Set LOBBYSTACK_<ROLE>_DATABASE_URL only to point a role at a different host.
# Disabled unless FINANCE_EXPORT_ENABLED=true. Provision this URL for the
# read-only lobbystack_finance_export PostgreSQL role; do not reuse app/worker.
LOBBYSTACK_FINANCE_EXPORT_DATABASE_URL=
FINANCE_EXPORT_ENABLED=false
FINANCE_EXPORT_TOKEN=
ADMIN_PORT=13000
WORKER_PORT=13002
# Startup isolation only; recreate all runtimes after changing. Not a durable
# webhook buffer. Drain active work first.
LOBBYSTACK_MAINTENANCE_MODE=false
# Temporary certification environments only. Missing allowlists fail closed.
# Phone purchase/release/webhook reconfiguration and live Polar billing are blocked.
LOBBYSTACK_CERTIFICATION_MODE=false
LOBBYSTACK_CERTIFICATION_EMAILS=
LOBBYSTACK_CERTIFICATION_PHONES=
LOBBYSTACK_CERTIFICATION_CALENDARS=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
REQUIRE_EMAIL_VERIFICATION=false
INTERNAL_SERVICE_SECRET=replace-with-a-long-service-secret
INTERNAL_SERVICE_TOKEN=replace-with-a-local-service-token
# Also encrypts webhook signing secrets and keys the HMAC for stored API key hashes;
# changing it invalidates existing API keys and webhook secrets.
ENCRYPTION_KEY=replace-with-a-long-application-encryption-key
OTP_HASH_SECRET=replace-with-a-long-otp-hash-secret
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
DEPLOYMENT_MODE=self_hosted_standard
APP_BASE_URL=http://localhost:13000
# The name and logo the dashboard shows instead of LobbyStack. Each one set here
# wins over what the deployment's first owner chooses in onboarding. The logo is
# an https URL or a path on the dashboard such as /brand/logo.svg. Give them to
# the admin build too, so prerendered sign-in pages show them straight away.
BRAND_APP_NAME=
BRAND_LOGO_URL=
# Where the admin's outside links go: the website, the terms and privacy pages,
# the docs, and the one address people write to. The admin build writes them
# in, so set them before building. Leave one empty to link to LobbyStack's.
NEXT_PUBLIC_LANDING_SITE_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_DOCS_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# The marketing site (lobbystack.com), which the admin serves on these hosts.
# The first is canonical and the others redirect to it. In `pnpm dev`, open
# http://lobbystack.localhost:13000. Leave empty to serve only the dashboard.
# Docker images include the site only when built with MARKETING_SITE=true.
MARKETING_HOSTS=lobbystack.localhost,www.lobbystack.localhost
# Its sign-in links, voice demo endpoint, and demo business. The admin build
# writes them in.
NEXT_PUBLIC_APP_URL=http://localhost:13000
NEXT_PUBLIC_LIVE_CALL_ENDPOINT=http://localhost:13000/api/voice/live/session
NEXT_PUBLIC_WEB_CALL_BUSINESS_SLUG=
WEB_CALL_ALLOWED_ORIGINS=http://localhost:13000,http://lobbystack.localhost:13000
WEB_CALL_PUBLIC_BUSINESS_SLUG=
# Widget IP limits use this single-value header only when you configure it.
TRUSTED_CLIENT_IP_HEADER=
APP_HOSTNAME=localhost
# Dev only: comma-separated extra hosts allowed to load the admin in `pnpm dev`.
ALLOWED_DEV_ORIGINS=
# Comma-separated origins allowed to sign in; defaults to APP_BASE_URL.
AUTH_TRUSTED_ORIGINS=
PROSPECT_DEMO_OPERATOR_EMAIL=
# Platform API keys (lsp_...) that onboard and manage businesses through /api/v1,
# as a JSON array. `pnpm platform-key:create` makes a key and prints its entry.
PLATFORM_API_KEYS=
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.lobbystack/storage
LOCAL_STORAGE_SIGNING_SECRET=replace-with-a-long-local-storage-signing-secret
S3_ENDPOINT=
S3_BUCKET=lobbystack
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
OPENAI_API_KEY=
AI_CHAT_API_KEY=
AI_CHAT_BASE_URL=https://api.openai.com/v1
# Website chat and calls. Leave blank for gpt-6-luna on OpenAI; set it for any other endpoint.
AI_CHAT_MODEL=
# OpenAI only: none, minimal, low, medium, high (default) or xhigh.
AI_CHAT_REASONING_EFFORT=
AI_CHAT_PROVIDER_NAME=openai
# The worker writes a one-line summary of each finished call on the AI_CHAT_* endpoint.
# Leave blank to use AI_CHAT_MODEL. A different model reports no cost, because the
# AI_CHAT_* prices below describe the chat model.
AI_SUMMARY_MODEL=
# OpenAI only: none, minimal, low (default), medium, high or xhigh.
AI_SUMMARY_REASONING_EFFORT=
# The worker answers GPT-Live's delegated requests on the AI_CHAT_* endpoint while the
# caller waits. Leave blank to use AI_CHAT_MODEL. A different model reports no cost.
AI_DELEGATION_MODEL=
# OpenAI only: none, minimal, low (default), medium, high or xhigh.
AI_DELEGATION_REASONING_EFFORT=
# OpenAI only: auto, default, flex or priority (default). Priority answers faster
# and costs twice the standard token price.
AI_DELEGATION_SERVICE_TIER=
# GPT-Live answers browser and phone calls. The admin receives OpenAI's incoming-call
# webhook; the worker holds each call's sideband connection. Phone numbers must sit on
# the Twilio SIP trunk, and the worker refuses to provision a number without
# TWILIO_SIP_TRUNK_SID. See docs/voice/runtime.md.
LIVE_PROTOTYPE_ENABLED=true
OPENAI_WEBHOOK_SECRET=
WORKER_INTERNAL_URL=http://127.0.0.1:13002
TWILIO_SIP_TRUNK_SID=
# Twilio sells UK, Australian and New Zealand numbers only under an approved
# regulatory bundle; Australian and New Zealand numbers also need the bundle's
# address. Set them on the admin and the worker. See "Sell numbers in the UK,
# Australia and New Zealand" in docs/voice/runtime.md.
TWILIO_GB_BUNDLE_SID=
TWILIO_AU_BUNDLE_SID=
TWILIO_AU_ADDRESS_SID=
TWILIO_NZ_BUNDLE_SID=
TWILIO_NZ_ADDRESS_SID=
# The Twilio Verify service that texts the onboarding phone code (admin).
TWILIO_VERIFY_SERVICE_SID=
# Prices for the AI_CHAT_* model in USD per million tokens, so chat, call
# summaries and live-call delegations record their cost. For gpt-6-luna:
# 0.1 input, 0.01 cached input and 0.5 output. Cached input falls back to the
# input price when unset.
AI_CHAT_INPUT_COST_PER_MILLION_TOKENS=
AI_CHAT_CACHED_INPUT_COST_PER_MILLION_TOKENS=
AI_CHAT_OUTPUT_COST_PER_MILLION_TOKENS=
AI_CHAT_PRICING_VERSION=
AI_CHAT_PRICING_SOURCE=
AI_CHAT_PRICING_EFFECTIVE_DATE=
# A configured chat price is used only with all three pricing metadata fields.
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_PROVIDER_NAME=openai
AI_EMBEDDING_REVISION=1
AI_EMBEDDING_INPUT_COST_PER_MILLION_TOKENS=
AI_EMBEDDING_PRICING_VERSION=
AI_EMBEDDING_PRICING_SOURCE=
AI_EMBEDDING_PRICING_EFFECTIVE_DATE=
# A configured embedding price is used only with all three pricing metadata fields.
# Applies to each embedding request. A large document sends one request per 128 chunks.
AI_EMBEDDING_TIMEOUT_MS=30000
AI_EMBEDDING_MAX_PARALLEL_CALLS=4
WIDGET_SESSION_SECRET=replace-with-a-long-widget-session-secret
# Existing keys continue working. Keep new chat/widget issuance restricted.
WIDGET_KEY_ISSUANCE_ENABLED=false
# Requests per minute allowed for each public API key (/api/v1). Needs REDIS_URL.
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120
# Plan-based content retention is on by default. Free keeps 30 days; paid plans
# keep messages 365, transcripts 90, recordings 90, and follow-ups 365.
# Set to false only to disable content deletion deployment-wide.
CONTENT_RETENTION_ENABLED=true
# Optional override for the paid periods. Free stays capped at 30 days.
CONTENT_RETENTION_POLICY_JSON=
# Backfill tooling requires an explicit local or approved worker-role URL.
CONTENT_RETENTION_DATABASE_URL=
# Recovery defaults to a read-only report; apply requires provider evidence.
VOICE_RECOVERY_DATABASE_URL=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=
# One Google OAuth client serves Google Calendar and "Continue with Google"
# sign-in, which turns on once both values below are set. Register both
# redirect URIs on the client: GOOGLE_REDIRECT_URI for Calendar, and
# APP_BASE_URL + /api/auth/callback/google for sign-in, for example
# https://app.example.com/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/calendar/google/callback
# Optional Instagram direct messages: a Meta app with the Instagram product and
# Business Login. Its OAuth redirect URI is INSTAGRAM_REDIRECT_URI, and its
# webhook callback is APP_BASE_URL + /api/webhooks/instagram, verified with
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN and subscribed to the messages field.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost/api/integrations/instagram/callback
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=replace-with-polar-webhook-secret
POLAR_ACCEPT_LEGACY_BUSINESS_IDS=false
POLAR_ORGANIZATION_ID=
POLAR_API_BASE_URL=
POLAR_STARTER_MONTHLY_PRODUCT_ID=
POLAR_STARTER_ANNUAL_PRODUCT_ID=
POLAR_PRO_MONTHLY_PRODUCT_ID=
POLAR_PRO_ANNUAL_PRODUCT_ID=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Client-side analytics token. PostHog includes `NEXT_PUBLIC_*` values in the
# browser bundle, so this is not a secret.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# LobbyStack's PostHog managed reverse proxy. Point this at your own PostHog
# host when running against your own project.
NEXT_PUBLIC_POSTHOG_HOST=https://ts.lobbystack.com
TWILIO_ACCOUNT_SID=
# The shared sender. Cloud businesses text operator alerts, customer appointment
# texts and change codes from it, and it answers STOP, START and HELP through
# /api/webhooks/twilio/sms. Self-hosted businesses text from their own number.
TWILIO_ALERT_SMS_FROM=
# Optional separate account that owns the shared sender. The worker key
# needs only /twilio/messaging/messages/create. Leave these blank for the default account.
TWILIO_ALERT_ACCOUNT_SID=
TWILIO_ALERT_API_KEY_SID=
TWILIO_ALERT_API_KEY_SECRET=
# Admin only: dedicated webhook signing key; never use the alert account's auth token.
# Apply it to the status callback URL and to /api/webhooks/twilio/sms when the
# shared sender's SMS webhook points at this app.
TWILIO_ALERT_WEBHOOK_KEY_ID=
TWILIO_ALERT_WEBHOOK_SECRET=
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
NUMBER_CLAIM_TOKEN_SECRET=replace-with-at-least-32-random-characters
TWILIO_SMS_WEBHOOK_URL=http://127.0.0.1:13000/api/webhooks/twilio/sms
TWILIO_STATUS_CALLBACK_URL=http://127.0.0.1:13000/api/webhooks/twilio/status
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=LobbyStack <no-reply@example.com>
EMAIL_REPLY_TO=
FEEDBACK_TO_EMAIL=
# Founder check-in sent 24 hours after onboarding to owners who have not come back. Leave empty to disable.
ONBOARDING_FOLLOWUP_FROM=
ONBOARDING_FOLLOWUP_SENDER_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
SERVICE_VERSION=development
