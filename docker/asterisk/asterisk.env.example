# Settings for the SIP server in this folder. Copy to asterisk.env and fill in the two marked ones.
# docs/voice/external-numbers.md explains each.

# Required. Your OpenAI project id, the same as OPENAI_PROJECT_ID on the worker.
OPENAI_PROJECT_ID=proj_replace_me

# Required. The carrier's SIP server addresses, comma separated, IPs or CIDRs. Only calls from them are accepted.
CARRIER_IPS=203.0.113.10

# The server's public IP, when it sits behind NAT. Leave empty on a server with its own public address.
PUBLIC_IP=

# Country code added to a caller number that starts with 0, without the plus. 381 is Serbia.
DEFAULT_COUNTRY_CODE=381

# The header that holds the caller's number, when the carrier puts it somewhere other than P-Asserted-Identity,
# Remote-Party-ID or From. Leave empty otherwise.
CALLER_HEADER=

# A certificate for this server's host name, when the carrier sends calls over TLS. Put the files in the certs folder
# next to docker-compose.yml, readable by the asterisk user, and name them as the container sees them:
#   TLS_CERT_FILE=/certs/fullchain.pem
#   TLS_KEY_FILE=/certs/privkey.pem
TLS_CERT_FILE=
TLS_KEY_FILE=

# The ports. Change them only to match your firewall.
SIP_UDP_PORT=5060
SIP_TLS_PORT=5061
RTP_START=10000
RTP_END=10200
