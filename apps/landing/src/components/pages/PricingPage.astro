---
import Layout from "@/layouts/main.astro"
import { Navbar } from "@/components/Navbar"
import { PricingSection } from "@/components/PricingSection"
import { PricingFaqSection } from "@/components/pricing/PricingFaqSection"
import { CtaSection } from "@/components/CtaSection"
import { Footer } from "@/components/Footer"
import { getPricingFaqs } from "@/lib/pricing-faqs"
import {
  breadcrumbJsonLd,
  faqPageJsonLd,
  organizationJsonLd,
  softwareApplicationJsonLd,
  absoluteUrl,
  webSiteJsonLd,
} from "@/lib/seo"
import {
  assertLocale,
  getCopy,
  getRouteSeo,
  localeTag,
  localizePath,
  type Locale,
} from "@/i18n"

interface Props {
  locale?: Locale
}

const locale = assertLocale(Astro.props.locale ?? Astro.currentLocale)
const copy = getCopy(locale)
const canonicalPath = localizePath(locale, "/pricing/")
const seo = getRouteSeo({ locale, path: "/pricing/" })
const breadcrumbNames: Record<Locale, string> = {
  en: "Pricing",
  fr: "Tarifs",
  es: "Precios",
  sr: "Cene",
}
---

<Layout
  seo={{
    ...seo,
    canonicalPath,
    locale,
    jsonLd: [
      organizationJsonLd(),
      webSiteJsonLd({ locale }),
      softwareApplicationJsonLd({ locale }),
      breadcrumbJsonLd([
        { name: copy.common.home, path: localizePath(locale, "/") },
        { name: breadcrumbNames[locale], path: canonicalPath },
      ]),
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": absoluteUrl(`${canonicalPath}#webpage`),
        name: seo?.title,
        url: absoluteUrl(canonicalPath),
        description: seo?.description,
        inLanguage: localeTag(locale),
        isPartOf: {
          "@id": absoluteUrl("/#website"),
        },
      },
      faqPageJsonLd({
        path: canonicalPath,
        faqs: getPricingFaqs(locale),
        locale,
      }),
    ],
  }}
>
  <Navbar locale={locale} />
  <main id="main-content" tabindex="-1">
    <PricingSection client:load locale={locale} />
    <PricingFaqSection locale={locale} />
    <CtaSection locale={locale} />
  </main>
  <Footer locale={locale} path={Astro.url.pathname} />
</Layout>
