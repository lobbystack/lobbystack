---
import Layout from "@/layouts/main.astro"
import { Navbar } from "@/components/Navbar"
import { Footer } from "@/components/Footer"
import { FeaturesCtaSection } from "@/components/features/FeaturesCtaSection"
import { render } from "astro:content"
import type { BlogEntry } from "@/lib/blog"
import { blogCanonicalSlug, blogPath, getBlogPosts } from "@/lib/blog"
import { nextInRotation } from "@/lib/related-posts"
import {
  blogJsonLd,
  blogPostingJsonLd,
  breadcrumbJsonLd,
  imageObjectJsonLd,
  organizationJsonLd,
  plainTextFromMarkdown,
  webSiteJsonLd,
} from "@/lib/seo"
import {
  assertLocale,
  getCopy,
  localizeHref,
  localizePath,
  type Locale,
} from "@/i18n"

interface Props {
  entry: BlogEntry
  locale?: Locale
}

const { entry } = Astro.props
const locale = assertLocale(
  Astro.props.locale ?? Astro.currentLocale ?? entry.data.locale
)
const copy = getCopy(locale)
const { Content } = await render(entry)

const canonicalPath = blogPath(entry, locale)
const publishedTime = entry.data.pubDate.toISOString()
const modifiedTime = (
  entry.data.updatedDate ?? entry.data.pubDate
).toISOString()
const coverImageAlt = entry.data.coverImageAlt ?? entry.data.title
const articleBody = plainTextFromMarkdown(entry.body)
const dateLocales = {
  en: "en-US",
  fr: "fr-FR",
  es: "es",
  sr: "sr-Latn",
} satisfies Record<Locale, string>
const dateLocale = dateLocales[locale]
const pageCopy = {
  en: {
    titleSuffix: "LobbyStack",
    updated: "Updated",
    by: "By",
    related: "Related reading",
    product: "Continue with LobbyStack",
  },
  fr: {
    titleSuffix: "LobbyStack",
    updated: "Mis à jour",
    by: "Par",
    related: "À lire aussi",
    product: "Continuer avec LobbyStack",
  },
  es: {
    titleSuffix: "LobbyStack",
    updated: "Actualizado",
    by: "Por",
    related: "Lecturas relacionadas",
    product: "Continúe con LobbyStack",
  },
  sr: {
    titleSuffix: "LobbyStack",
    updated: "Ažurirano",
    by: "Autor:",
    related: "Pročitajte i ovo",
    product: "Nastavite uz LobbyStack",
  },
} satisfies Record<
  Locale,
  {
    titleSuffix: string
    updated: string
    by: string
    related: string
    product: string
  }
>
const displayedDate = (
  entry.data.updatedDate ?? entry.data.pubDate
).toLocaleDateString(dateLocale, {
  day: "numeric",
  month: "short",
  year: "numeric",
})
const displayedDateLabel = entry.data.updatedDate
  ? `${pageCopy[locale].updated} ${displayedDate}`
  : displayedDate

const coverImageWidth = 1672
const coverImageHeight = 941
const allPosts = await getBlogPosts(locale)
const relatedPosts = nextInRotation(
  allPosts.filter(
    (candidate) => candidate.data.category === entry.data.category
  ),
  entry,
  3,
  (a, b) => blogCanonicalSlug(a) === blogCanonicalSlug(b)
)
const fallbackRelatedPosts = allPosts
  .filter(
    (candidate) =>
      blogCanonicalSlug(candidate) !== blogCanonicalSlug(entry) &&
      !relatedPosts.some(
        (related) => blogCanonicalSlug(related) === blogCanonicalSlug(candidate)
      )
  )
  .slice(0, 3 - relatedPosts.length)
const displayedRelatedPosts = [...relatedPosts, ...fallbackRelatedPosts]
const slug = blogCanonicalSlug(entry)
const resourceLabels = {
  en: {
    openSource: "Open-source AI receptionist",
    selfHosted: "Self-hosted deployment",
    calculator: "Missed-call revenue calculator",
    phoneAnswering: "AI phone answering",
    pricing: "Pricing",
  },
  fr: {
    openSource: "Réceptionniste IA open source",
    selfHosted: "Déploiement auto-hébergé",
    calculator: "Calculateur d’appels manqués",
    phoneAnswering: "Réponse téléphonique IA",
    pricing: "Tarifs",
  },
  es: {
    openSource: "Recepcionista con IA de código abierto",
    selfHosted: "Implementación autoalojada",
    calculator: "Calculadora de llamadas perdidas",
    phoneAnswering: "Atención telefónica con IA",
    pricing: "Precios",
  },
  sr: {
    openSource: "AI recepcioner otvorenog koda",
    selfHosted: "Samostalno hostovanje",
    calculator: "Kalkulator propuštenih poziva",
    phoneAnswering: "AI odgovaranje na pozive",
    pricing: "Cene",
  },
} satisfies Record<
  Locale,
  {
    openSource: string
    selfHosted: string
    calculator: string
    phoneAnswering: string
    pricing: string
  }
>
const labels = resourceLabels[locale]
const productResources = slug.includes("open-source")
  ? [
      {
        label: labels.openSource,
        href: "/solutions/open-source-ai-receptionist/",
      },
      {
        label: labels.selfHosted,
        href: "/solutions/self-hosted-ai-receptionist/",
      },
    ]
  : slug.includes("savings")
    ? [
        {
          label: labels.calculator,
          href: "/missed-call-revenue-calculator/",
        },
        {
          label: labels.phoneAnswering,
          href: "/solutions/ai-phone-answering/",
        },
      ]
    : [
        {
          label: labels.phoneAnswering,
          href: "/solutions/ai-phone-answering/",
        },
        {
          label: labels.pricing,
          href: "/pricing/",
        },
      ]
---

<Layout
  seo={{
    title:
      entry.data.seoTitle ??
      `${entry.data.title} | ${pageCopy[locale].titleSuffix}`,
    description: entry.data.description,
    canonicalPath,
    locale,
    image: entry.data.coverImage,
    imageAlt: coverImageAlt,
    imageWidth: entry.data.coverImage ? coverImageWidth : undefined,
    imageHeight: entry.data.coverImage ? coverImageHeight : undefined,
    type: "article",
    publishedTime,
    modifiedTime,
    author: entry.data.author,
    jsonLd: [
      organizationJsonLd(),
      webSiteJsonLd({ locale }),
      blogJsonLd({ locale, path: localizePath(locale, "/blog/") }),
      imageObjectJsonLd({
        path: canonicalPath,
        image: entry.data.coverImage,
        alt: coverImageAlt,
        width: coverImageWidth,
        height: coverImageHeight,
      }),
      blogPostingJsonLd({
        title: entry.data.title,
        description: entry.data.description,
        path: canonicalPath,
        image: entry.data.coverImage,
        author: entry.data.author,
        publishedTime,
        modifiedTime,
        articleBody,
        category: entry.data.category,
        locale,
      }),
      breadcrumbJsonLd([
        { name: copy.common.home, path: localizePath(locale, "/") },
        { name: "Blog", path: localizePath(locale, "/blog/") },
        { name: entry.data.title, path: canonicalPath },
      ]),
    ],
  }}
>
  <Navbar locale={locale} />

  <article
    id="main-content"
    class="min-h-screen bg-background pb-24 text-foreground"
  >
    <div class="mx-auto max-w-[760px] px-6 pt-24">
      <header class="mb-10">
        <h1 class="display-heading mb-6 text-foreground">
          {entry.data.title}
        </h1>

        <div class="flex items-center gap-4">
          {
            entry.data.category && (
              <span class="rounded-md border border-border/60 px-2.5 py-1 font-mono text-[0.6875rem] text-muted-foreground">
                {entry.data.category}
              </span>
            )
          }
          <time
            class="text-xs font-medium text-muted-foreground"
            datetime={modifiedTime}
          >
            {displayedDateLabel}
          </time>
          <span class="text-xs font-medium text-muted-foreground">
            {pageCopy[locale].by}
            {entry.data.author}
          </span>
        </div>
      </header>

      {
        entry.data.coverImage && (
          <div class="mb-12 aspect-[16/9] overflow-hidden rounded-2xl border border-border/30 bg-muted shadow-sm">
            <img
              src={entry.data.coverImage}
              alt={coverImageAlt}
              width="1672"
              height="941"
              class="h-full w-full object-cover"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        )
      }

      <div class="blog-copy max-w-none">
        <Content />
      </div>

      <aside class="mt-16 border-t border-border/50 pt-10">
        <h2 class="text-2xl font-semibold">{pageCopy[locale].related}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {
            displayedRelatedPosts.map((post) => (
              <a
                href={blogPath(post, locale)}
                class="rounded-xl border border-border/60 p-4 text-sm font-medium transition-colors hover:border-primary/50"
              >
                {post.data.title}
              </a>
            ))
          }
        </div>

        <h2 class="mt-10 text-xl font-semibold">
          {pageCopy[locale].product}
        </h2>
        <div class="mt-4 flex flex-wrap gap-3">
          {
            productResources.map((resource) => (
              <a
                href={localizeHref(locale, resource.href)}
                class="rounded-full border border-border/60 px-4 py-2 text-sm font-medium transition-colors hover:border-primary/50"
              >
                {resource.label}
              </a>
            ))
          }
        </div>
      </aside>
    </div>
  </article>

  <FeaturesCtaSection locale={locale} />
  <Footer locale={locale} path={Astro.url.pathname} />
</Layout>
