---
import { ArrowUpRight } from "lucide-react"

// Steps and requirements match mintlify/self-hosting/docker-compose.mdx.
const steps = [
  {
    title: "Clone the repository",
    command:
      "git clone https://github.com/lobbystack/lobbystack.git && cd lobbystack",
  },
  {
    title: "Generate secrets",
    body: "The script creates .env and fills every database password and internal secret with a random value.",
    command: "node scripts/generate-env.mjs",
  },
  {
    title: "Add your provider keys",
    body: "Open .env and set APP_BASE_URL, OPENAI_API_KEY, and your Twilio credentials.",
  },
  {
    title: "Start the stack",
    body: "Migrations run before the dashboard and worker start.",
    command: "docker compose --env-file .env up -d --build",
  },
]

const requirements = [
  "Docker Engine 24 or later with Compose v2",
  "Node.js 22 or later, to generate secrets",
  "A server with 2 vCPU, 4 GB of RAM, and persistent disk",
  "Domains with HTTPS for the dashboard and voice gateway",
  "Twilio and OpenAI accounts",
]
---

<section class="border-t border-border/40 py-20 md:py-28" id="deploy">
  <div
    class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)] lg:gap-16"
  >
    <div>
      <h2 class="section-heading">Deploy with Docker Compose</h2>
      <p class="section-intro">
        The official setup runs on one server. On Railway, you can deploy the
        LobbyStack template instead, and it generates the secrets for you.
      </p>
      <ol class="mt-10 border-t border-border/70">
        {
          steps.map((step, index) => (
            <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 border-b border-border/70 py-6">
              <span class="text-sm font-medium text-muted-foreground tabular-nums">
                {index + 1}
              </span>
              <div class="min-w-0">
                <h3 class="font-medium text-foreground">{step.title}</h3>
                {step.body && (
                  <p class="body-copy mt-1 text-base">{step.body}</p>
                )}
                {step.command && (
                  <code class="mt-3 block overflow-x-auto rounded-lg bg-muted/60 px-3 py-2 font-mono text-[13px] whitespace-nowrap text-foreground [font-variant-ligatures:none]">
                    {step.command}
                  </code>
                )}
              </div>
            </li>
          ))
        }
      </ol>
      <a
        href="https://docs.lobbystack.com/self-hosting/docker-compose"
        class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-foreground"
      >
        Read the full Docker Compose guide
        <ArrowUpRight className="size-3.5" aria-hidden="true" />
      </a>
    </div>

    <aside class="lg:pt-2">
      <h3 class="text-sm font-medium text-foreground">You'll need</h3>
      <ul class="mt-4 space-y-3 text-sm text-muted-foreground">
        {
          requirements.map((item) => (
            <li class="flex gap-2.5">
              <span
                class="mt-2 size-1 shrink-0 rounded-full bg-foreground/60"
                aria-hidden="true"
              />
              {item}
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</section>
