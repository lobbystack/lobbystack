{
  "name": "@lobbystack/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:check": "tsx src/cli.ts check",
    "db:seed": "tsx src/cli.ts seed",
    "db:reset:test": "tsx src/cli.ts reset-test",
    "db:verify-rls": "tsx src/cli.ts verify-rls"
  },
  "dependencies": {
    "@lobbystack/contracts": "workspace:*",
    "@lobbystack/telemetry": "workspace:*",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.8",
    "vitest": "^4.1.11"
  }
}
