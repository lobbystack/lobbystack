{
  "name": "@lobbystack/cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The lobbystack command: onboard and manage businesses through the LobbyStack API.",
  "bin": {
    "lobbystack": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lobbystack/shared": "workspace:*",
    "yaml": "^2.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsup": "8.5.1",
    "vitest": "^5.0.3"
  }
}
